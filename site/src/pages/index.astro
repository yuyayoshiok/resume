---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectIcon from "../components/ProjectIcon.astro";
import { profile, story, skillGroups, workIntro, workCards, articles, aboutItems } from "../data/profile";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const photos = "https://www.cgr.mlit.go.jp/matsukoku/sinjiko/photo.html";
const previews: Record<string, string> = { kanban: "kanban-board.webp", "ai-office": "ai-office-overview.webp" };
---
<Layout title="Y.Yuya — Portfolio">
  <a class="skip-link" href="#main">本文へ移動</a>
  <header class="site-header">
    <a class="wordmark" href={`${base}/`} aria-label="Y.Yuya トップ">Y.Yuya<span class="wordmark__dot">.</span></a>
    <nav aria-label="メインナビゲーション">
      <a href="#projects">制作実績</a><a href="#about">プロフィール</a><a href="#writing">技術発信</a>
    </nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__heading">
        <div><p class="eyebrow">ENGINEER / SHIMANE, JAPAN</p><h1 id="hero-title">{profile.name}<span>Portfolio</span></h1></div>
        <div class="hero__intro"><p>{profile.bio.map((line) => <>{line}<br /></>)}</p><a class="text-link" href="#projects">制作実績を見る <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="hero__photo">
        <img src={`${base}/images/shinjiko-evening.jpg`} alt="宍道湖の水面に夕空が映り、遠くに嫁ヶ島が見える風景" width="1152" height="768" fetchpriority="high" />
        <figcaption><span>01 / LAKE SHINJI</span><span>宍道湖、島根県松江市</span></figcaption>
      </figure>
      <div class="hero__bottom"><span>AIとつくる、日々の仕事と暮らし。</span><a href="#projects">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <header class="section-heading"><div><p class="eyebrow">01 / SELECTED PROJECTS</p><h2 id="projects-title">自分の手で、つくる。</h2></div><p>日々の不便から始まった個人開発。<br />設計から実装、運用まで取り組んでいます。</p></header>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <a class={`project-card${previews[project.id] ? " project-card--visual" : ""}`} href={`${base}/projects/${project.id}/`}>
            {previews[project.id] && <div class="project-card__preview"><img src={`${base}/images/${previews[project.id]}`} alt={`${project.data.title}の画面`} width="1600" height="1000" loading="lazy" /></div>}
            <div class="project-card__body"><div class="project-card__top"><span class="eyebrow">PROJECT / {String(index + 1).padStart(2, "0")}</span><ProjectIcon name={project.data.icon} /></div>
            <h3>{project.data.title}</h3><p class="project-card__desc">{project.data.desc}</p><div class="project-card__tags">{project.data.tags.map((tag) => <span>{tag}</span>)}</div><span class="project-card__cta">詳しく見る <span aria-hidden="true">↗</span></span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <header class="section-heading"><div><p class="eyebrow">02 / PROFESSIONAL WORK</p><h2 id="work-title">現場で、役に立つものを。</h2></div><p>{workIntro}</p></header>
      <div class="work-list">{workCards.map((card) => <article class="work-card"><div><p class="eyebrow">{card.badge}</p><h3>{card.title}</h3><p class="work-card__tech">{card.tech.join(" / ")}</p></div><div><p>{card.desc}</p><ul>{card.results.map((result) => <li>{result}</li>)}</ul></div></article>)}</div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="about-grid"><figure class="about-photo"><img src={`${base}/images/shinjiko-sunset.jpg`} alt="宍道湖の嫁ヶ島の向こうに沈む夕日と、水面に反射する光" width="1024" height="768" loading="lazy" /><figcaption>02 / LAKE SHINJI, MATSUE</figcaption></figure>
      <div class="about-copy"><p class="eyebrow">03 / ABOUT ME</p><h2 id="about-title">島根県松江市を拠点に。</h2><div class="story">{story.paragraphs.map((p) => <p>{p}</p>)}<p class="story__highlight">{story.highlight}</p></div><dl class="about-details">{aboutItems.map((item) => <div><dt>{item.label}</dt><dd>{item.status}</dd></div>)}</dl></div></div>
    </section>

    <section class="section" aria-labelledby="skills-title"><header class="section-heading"><div><p class="eyebrow">04 / TOOLBOX</p><h2 id="skills-title">開発に使っている技術。</h2></div></header><div class="skills-grid">{skillGroups.map((group) => <div class="skills-group"><h3>{group.title}</h3><div class="skills">{group.tags.map((tag) => <span>{tag}</span>)}</div></div>)}</div></section>

    <section class="section" id="writing" aria-labelledby="writing-title"><header class="section-heading"><div><p class="eyebrow">05 / WRITING</p><h2 id="writing-title">つくって、書いて、考える。</h2></div><p>開発の記録と、AIとの付き合い方。</p></header><div class="article-list">{articles.map((article) => <a href={article.href} target="_blank" rel="noopener noreferrer"><span class="eyebrow">{article.site}</span><h3>{article.title}</h3><span aria-hidden="true">↗</span></a>)}</div></section>
  </main>
  <footer class="footer"><div class="footer__top"><a class="wordmark" href="#main">Y.Yuya.</a><div class="social-links">{profile.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></div><div class="footer__bottom"><p>&copy; 2026 Y.Yuya</p><a href={photos} target="_blank" rel="noopener noreferrer">宍道湖の写真：国土交通省 松江国道事務所</a></div></footer>
</Layout>
