---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectIcon from "../components/ProjectIcon.astro";
import {
  profile,
  story,
  skillGroups,
  workIntro,
  workCards,
  articles,
  aboutItems,
} from "../data/profile";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Y.Yuya — Portfolio">
  <section class="hero">
    <p class="hero__greeting fade-in">{profile.greeting}</p>
    <h1 class="hero__name fade-in">{profile.name}</h1>
    <p class="hero__bio fade-in">
      {
        profile.bio.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
    <div class="hero__links fade-in">
      {
        profile.links.map((link) => (
          <a
            class="hero__link"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.icon === "github" && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            )}
            {link.icon === "x" && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            )}
            {link.icon === "note" && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M22 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 19.5v-15A2.5 2.5 0 0 1 4.5 2h15A2.5 2.5 0 0 1 22 4.5zM7 7.5a1 1 0 1 0-2 0 1 1 0 0 0 2 0zM19 7H9v2h10V7zm0 4H5v2h14v-2zm0 4H5v2h14v-2z" />
              </svg>
            )}
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="hero__scroll">
      <span>scroll</span>
    </div>
  </section>

  <section class="section section--alt fade-in">
    <div class="section__header">
      <span class="section__number">{story.number}</span>
      <span class="section__title">{story.title}</span>
      <span class="section__line"></span>
    </div>
    <div class="story">
      {story.paragraphs.map((p) => <p class="story__text">{p}</p>)}
      <p class="story__text">
        <span class="story__highlight">{story.highlight}</span>
      </p>
    </div>
  </section>

  <section class="section fade-in">
    <div class="section__header">
      <span class="section__number">02</span>
      <span class="section__title">スキル</span>
      <span class="section__line"></span>
    </div>
    <div class="skills-grid">
      {
        skillGroups.map((group) => (
          <div class="skills-group">
            <h3 class="skills-group__title">{group.title}</h3>
            <div class="skills">
              {group.tags.map((tag) => (
                <span class="skill-tag">{tag}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt fade-in">
    <div class="section__header">
      <span class="section__number">03</span>
      <span class="section__title">実務</span>
      <span class="section__line"></span>
    </div>
    <p class="work__intro">{workIntro}</p>
    <div class="work-grid">
      {
        workCards.map((card) => (
          <div class={`work-card${"featured" in card && card.featured ? " work-card--featured" : ""}`}>
            <div class="work-card__badge">{card.badge}</div>
            <h3 class="work-card__title">{card.title}</h3>
            <p class="work-card__tech">{card.tech.join(" / ")}</p>
            <p class="work-card__desc">{card.desc}</p>
            <ul class="work-card__results">
              {card.results.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section fade-in">
    <div class="section__header">
      <span class="section__number">04</span>
      <span class="section__title">個人開発</span>
      <span class="section__line"></span>
    </div>
    <div class="projects-grid">
      {
        projects.map((project) => (
          <a class="project-card" href={`${base}/projects/${project.id}/`}>
            <ProjectIcon name={project.data.icon} />
            <h3 class="project-card__title">{project.data.title}</h3>
            <p class="project-card__desc">{project.data.desc}</p>
            <div class="project-card__tags">
              {project.data.tags.map((tag) => (
                <span class="project-card__tag">{tag}</span>
              ))}
            </div>
            <span class="project-card__cta">View details &rarr;</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section--alt fade-in">
    <div class="section__header">
      <span class="section__number">05</span>
      <span class="section__title">技術発信</span>
      <span class="section__line"></span>
    </div>
    <div class="work-grid">
      {
        articles.map((article) => (
          <a
            class="work-card work-card--link"
            href={article.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="work-card__badge">{article.site}</div>
            <h3 class="work-card__title">{article.title}</h3>
            <span class="project-card__cta">Read &rarr;</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section fade-in">
    <div class="section__header">
      <span class="section__number">06</span>
      <span class="section__title">About</span>
      <span class="section__line"></span>
    </div>
    <div class="about-work">
      <div class="about-work__grid">
        {
          aboutItems.map((item) => (
            <div class="about-work__item">
              <h3 class="about-work__label">{item.label}</h3>
              <p class="about-work__status">{item.status}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="footer fade-in">
    <p>&copy; 2026 Y.Yuya</p>
  </footer>
</Layout>
