---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "project-card__icon" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "board" && (
      <>
        <rect x="3" y="4" width="5.5" height="16" rx="1.2" />
        <rect x="10.5" y="4" width="5.5" height="11" rx="1.2" />
        <rect x="18" y="4" width="3" height="7" rx="1.2" />
      </>
    )
  }
  {
    name === "bot" && (
      <>
        <rect x="4" y="8.5" width="16" height="11.5" rx="2.5" />
        <path d="M12 8.5V5.5" />
        <circle cx="12" cy="4" r="1.4" />
        <path d="M9.5 13v1.5M14.5 13v1.5" />
        <path d="M10 17.5h4" />
      </>
    )
  }
  {
    name === "dumbbell" && (
      <>
        <rect x="2" y="8.5" width="3.5" height="7" rx="1.2" />
        <rect x="18.5" y="8.5" width="3.5" height="7" rx="1.2" />
        <rect x="6.5" y="6.5" width="3" height="11" rx="1.2" />
        <rect x="14.5" y="6.5" width="3" height="11" rx="1.2" />
        <path d="M9.5 12h5" />
      </>
    )
  }
  {
    name === "mic" && (
      <>
        <rect x="9" y="2.5" width="6" height="11" rx="3" />
        <path d="M5 11.5a7 7 0 0 0 14 0" />
        <path d="M12 18.5v3M8.5 21.5h7" />
      </>
    )
  }
  {
    name === "radio" && (
      <>
        <circle cx="12" cy="12" r="2.2" />
        <path d="M8.1 8.1a5.5 5.5 0 0 0 0 7.8M15.9 8.1a5.5 5.5 0 0 1 0 7.8" />
        <path d="M5.2 5.2a9.6 9.6 0 0 0 0 13.6M18.8 5.2a9.6 9.6 0 0 1 0 13.6" />
      </>
    )
  }
  {
    name === "video" && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="3" />
        <path d="M10.2 9.3l5.2 2.7-5.2 2.7z" />
      </>
    )
  }
  {
    name === "bookmark" && (
      <>
        <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8L5.5 20.5v-16a1 1 0 0 1 1-1z" />
      </>
    )
  }
  {
    name === "chart" && (
      <>
        <path d="M3.5 20.5h17" />
        <path d="M4 16.5l5-5 3.5 3L20 6.5" />
        <path d="M20 11V6.5h-4.5" />
      </>
    )
  }
</svg>
